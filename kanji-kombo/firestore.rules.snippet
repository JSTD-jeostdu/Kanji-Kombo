// ┌──────────────────────────────────────────────────────────────────────┐
// │  ⚠️  이 파일을 규칙 편집기에 통째로 붙여넣지 마세요.                  │
// │                                                                      │
// │  Firestore 보안 규칙은 **데이터베이스당 하나**뿐입니다. 기존 프로젝트 │
// │  에 앱만 추가하는 구성이므로, 지금 규칙을 통째로 갈아끼우면 같은      │
// │  프로젝트를 쓰는 다른 앱이 즉시 접근을 잃습니다.                     │
// │                                                                      │
// │  아래 match 블록 **하나만** 복사해서, 기존 규칙의                    │
// │  `match /databases/{database}/documents { ... }` 안에 넣으세요.       │
// └──────────────────────────────────────────────────────────────────────┘

// ───── 여기부터 복사 ─────
    // 칸지콤보: 학습 기록 문서. 본인 것만 읽고 쓸 수 있다.
    match /kanjiKombo/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
// ───── 여기까지 복사 ─────


// ══════════════════════════════════════════════════════════════════════
// 붙여넣고 나면 이런 모양이 됩니다 (기존 규칙은 그대로 두세요)
// ══════════════════════════════════════════════════════════════════════
//
// rules_version = '2';
// service cloud.firestore {
//   match /databases/{database}/documents {
//
//     // ↓↓↓ 기존 앱 규칙 — 손대지 않는다 ↓↓↓
//     match /someExistingCollection/{docId} {
//       allow read, write: if ...;
//     }
//     // ↑↑↑ 기존 앱 규칙 ↑↑↑
//
//     // ↓↓↓ 칸지콤보용으로 새로 추가한 부분 ↓↓↓
//     match /kanjiKombo/{userId} {
//       allow read, write: if request.auth != null && request.auth.uid == userId;
//     }
//   }
// }
//
// ══════════════════════════════════════════════════════════════════════
// (선택) 더 엄격하게 — 문서에 예상 밖의 필드가 들어오는 것까지 막고 싶다면
// ══════════════════════════════════════════════════════════════════════
//
//     match /kanjiKombo/{userId} {
//       allow read: if request.auth != null && request.auth.uid == userId;
//       allow write: if request.auth != null
//                    && request.auth.uid == userId
//                    && request.resource.data.keys().hasOnly([
//                         'version', 'settings', 'cards', 'dayHistory',
//                         'bonusNewByDay', 'lastStudiedDay', 'updatedAt'
//                       ]);
//     }
//
// 주의: 나중에 앱에서 필드를 추가하면 이 목록도 같이 고쳐야 쓰기가 통과합니다.
// 개인용 앱이라면 위의 단순한 버전으로 충분합니다.
